# =============================================================================
# GA 분석 페이지용 서버(Serverless) 환경변수 예시
# =============================================================================
# 이 값들은 Vite 빌드 env(.env.beta/.env.real, VITE_* 접두어)가 아니라,
# Vercel 서버리스 함수(api/ga/overview.js)가 런타임에 읽는 "서버 전용" 값이다.
# 브라우저에 절대 노출되면 안 되므로 VITE_ 접두어를 붙이지 않는다.
#
# 설정 위치: Vercel → Project → Settings → Environment Variables
#   (Preview 환경 = beta, Production 환경 = real 로 각각 등록)
#
# 로컬에서 함수까지 실행/검증하려면 `vercel dev` 사용 후 이 값들을 로컬 env 로 주입한다.
# (`npm start`(vite dev)는 서버리스 함수를 실행하지 못함)
# -----------------------------------------------------------------------------

# GA4 속성 ID (숫자만). GA4 콘솔 → 관리 → 속성 설정 → 속성 ID
GA4_PROPERTY_ID=

# 서비스 계정 이메일 (GCP IAM 에서 발급, GA4 속성에 "뷰어" 권한 부여 필요)
GA_CLIENT_EMAIL=

# 서비스 계정 private key (PEM 전체).
# Vercel UI 입력 시 개행이 리터럴 \n 으로 저장돼도 함수가 자동 복원한다.
# 예: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GA_PRIVATE_KEY=

# 참고: 이전에 있던 MOREE_API_BASE(토큰 백엔드 재검증)는 제거되었다.
# 함수는 이제 토큰 "존재" 여부만 확인하므로 이 값은 설정할 필요 없다(있어도 무시됨).
