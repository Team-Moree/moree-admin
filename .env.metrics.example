# =============================================================================
# 서버 메트릭(Grafana Cloud) 페이지용 서버(Serverless) 환경변수 예시
# =============================================================================
# 이 값들은 Vite 빌드 env(.env.beta/.env.real, VITE_* 접두어)가 아니라,
# Vercel 서버리스 함수(api/metrics/overview.js)가 런타임에 읽는 "서버 전용" 값이다.
# 브라우저에 절대 노출되면 안 되므로 VITE_ 접두어를 붙이지 않는다.
#
# 설정 위치: Vercel → Project → Settings → Environment Variables
#
# 로컬에서 함수까지 실행/검증하려면 `vercel dev` 사용 (`npm start`는 서버리스 함수를 실행 못함)
# -----------------------------------------------------------------------------

# Grafana Cloud 스택 URL (예: https://loftysummit1845.grafana.net)
GRAFANA_STACK_URL=

# Prometheus(Mimir) 데이터소스 UID
# Grafana → Connections → Data sources 에서 확인 (보통 grafanacloud-<stack>-prom)
GRAFANA_PROM_DATASOURCE_UID=

# 서비스 계정 토큰 (Administration → Users and access → Service accounts, Viewer 롤)
GRAFANA_SA_TOKEN=
