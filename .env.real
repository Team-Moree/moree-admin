# 운영(REAL) 빌드 (npm run build:real / start:real)
# Vercel Production(= 운영 브랜치) 배포에서 사용
VITE_APP_ENV=real

# 로컬 start:real 시 프록시 대상 (배포 빌드에는 영향 없음)
