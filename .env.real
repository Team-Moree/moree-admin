# 운영(REAL) 빌드 (npm run build:real / start:real)
# Vercel Production(= 운영 브랜치) 배포에서 사용
VITE_APP_ENV=real

# 로컬 start:real 시 프록시 대상 (배포 빌드에는 영향 없음)
VITE_DEV_PROXY_TARGET=https://api.moree.app

# VITE_API_BASE_URL 미설정 → client 가 '/api' 로 호출 →
# vercel.json rewrite 를 통해 api.moree.app 으로 전달 (CORS 불필요)
VITE_NAVER_MAP_KEY=fbukkes79a
VITE_GOOGLE_MAPS_KEY=AIzaSyDFHDPCEQpPkI4HNxZQsgbjrfmTUS0abUg

# (선택) 스토어 지도의 AdvancedMarker 렌더링에 쓰이는 Map ID.
# Cloud Console → Google Maps Platform → Map management 에서 발급한다.
# 미설정 시 구글 샘플용 'DEMO_MAP_ID' 로 폴백하며, 지도/마커는 동작하고 클라우드 스타일링만 빠진다.
# VITE_GOOGLE_MAPS_ID=
