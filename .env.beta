# 개발(BETA) 빌드 (npm run build:beta / start:beta)
# Vercel Preview(= dev 브랜치/PR) 배포에서 사용
VITE_APP_ENV=beta

# 로컬 start:beta 시 프록시 대상 (배포 빌드에는 영향 없음)
VITE_DEV_PROXY_TARGET=https://api.moree.app

# [초기] VITE_API_BASE_URL 미설정 → client 가 '/api' 로 호출 →
#        vercel.json rewrite 를 통해 api.moree.app 으로 전달 (CORS 불필요).
#        "초기에는 개발 서버에서도 api.moree.app 유지" 요구사항 충족.
# [전환] 개발 API 를 dev.api.moree.app 으로 직접 호출하려면 아래 주석 해제
#        (백엔드에서 프론트 오리진 CORS 허용 필요):
# VITE_API_BASE_URL=https://dev.api.moree.app

VITE_NAVER_MAP_KEY=fbukkes79a
