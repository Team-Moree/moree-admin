# 개발(BETA) 빌드 (npm run build:beta / start:beta)
# Vercel Preview(= dev 브랜치/PR) 배포에서 사용
VITE_APP_ENV=beta

# 로컬 start:beta 시 프록시 대상 (배포 빌드에는 영향 없음)
# 배포와 동일하게 개발 API 를 바라본다. (vite 프록시는 서버사이드라 CORS 무관)
VITE_DEV_PROXY_TARGET=https://dev.api.moree.app

# VITE_API_BASE_URL 미설정 → client 가 프로필별 same-origin prefix('/api-beta') 로 호출 →
#   - 배포: vercel.json rewrite 로 dev.api.moree.app 에 서버사이드 프록시 (CORS 불필요)
#   - 로컬(start:beta): vite 프록시가 VITE_DEV_PROXY_TARGET 으로 전달
# 특정 호스트로 직접 호출하려면 아래처럼 지정 (단, 직접 호출은 백엔드 CORS 허용 필요):
# VITE_API_BASE_URL=https://dev.api.moree.app

VITE_GOOGLE_MAPS_KEY=AIzaSyDFHDPCEQpPkI4HNxZQsgbjrfmTUS0abUg
